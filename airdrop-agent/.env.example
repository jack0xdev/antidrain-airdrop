# ---- Claude (https://console.anthropic.com -> API keys) ----
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 (best) | claude-sonnet-5-5 (about half the cost)
AGENT_MODEL=claude-opus-5-5
# low | medium | high  (higher = smarter but slower/costlier)
AGENT_EFFORT=medium
MAX_STEPS_PER_TASK=80

# ---- Telegram control bot ----
# create a bot with @BotFather, get your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_OWNER_ID=123456789

# ---- VNC (watch the browser / log in yourself) ----
VNC_PASSWORD=change-me-8chars

# ---- Burner wallet ----
# NEVER put your main wallet here. Make a fresh one, fund it with only gas money.
BURNER_PRIVATE_KEY=0x...
DEFAULT_CHAIN_ID=1
# every transaction waits for your Telegram tap (set false for full auto inside the caps)
REQUIRE_TX_APPROVAL=true
# plain-text "Sign in with Ethereum" messages are signed automatically
AUTO_APPROVE_LOGIN_SIGNATURES=true
MAX_TX_VALUE_ETH=0.01
DAILY_SPEND_CAP_ETH=0.05
APPROVAL_TIMEOUT_SECONDS=900

# optional: better RPCs (public ones rate-limit)
# RPC_1=https://eth-mainnet.g.alchemy.com/v2/KEY
# RPC_8453=https://base-mainnet.g.alchemy.com/v2/KEY
# optional: extra chains as JSON
# EXTRA_CHAINS_JSON={"11155111": {"name": "Sepolia", "rpc": "https://ethereum-sepolia-rpc.publicnode.com", "symbol": "ETH", "explorer": "https://sepolia.etherscan.io"}}

DATA_DIR=/data
